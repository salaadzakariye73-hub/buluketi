# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (defaults to 3000)
PORT=3000

# MongoDB Atlas Connection URI (leave empty in local preview to use embedded MongoDB)
MONGODB_URI=""

# JWT Secret & Expiration (change in production!)
JWT_SECRET="change-this-to-a-long-random-secret-key-in-production"
JWT_EXPIRES_IN="7d"

# Comma-separated allowed CORS origins for split deployment (e.g. Cloudflare Pages URL)
CORS_ORIGIN=""

# Initial Admin Seed Credentials (used by seed script or initial setup)
SEED_ADMIN_NAME="Admin Manager"
SEED_ADMIN_EMAIL="admin@bulukeeti.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
